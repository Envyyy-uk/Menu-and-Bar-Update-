# Локальна розробка. Для продакшена всі значення обов'язково змінити.

DATABASE_URL=postgresql+psycopg://menu:menu@db:5432/menu

# Підпис сесійних токенів. У продакшені — випадковий рядок від 32 символів.
SECRET_KEY=dev-secret-change-me-in-production

# Перший owner, якого створює сідер.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-please-12
SEED_STAFF_PIN=246810

# Stripe. Порожні ключі = платежі вимкнені, замовлення живуть у тестовому
# режимі «оплата вручну» (Спринт 5).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_BPS=0

PUBLIC_BASE_URL=http://localhost:8000
